# AI 네이버 블로그 생성기 - API 키 설정
# 이 파일을 복사해서 .env 파일을 만들고, 실제 API 키를 입력하세요.

# OpenRouter API 키 (Claude AI 사용)
# 발급: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Higgsfield API 키 (이미지 생성)
# 발급: https://open.higgsfield.ai
# 형식: API_KEY:API_SECRET (콜론으로 연결)
HIGGSFIELD_API_KEY=your-api-key:your-api-secret

# 테스트 모드 (1=테스트, 0=실제)
# 1로 설정하면 AI 호출 없이 더미 데이터로 테스트 가능
DRY_RUN=0
